# NLM Proxy Configuration
# Copy to .env or ~/.nlm-proxy/.env and uncomment to customize

# =============================================================================
# Shared Settings
# =============================================================================
# NLM_PROXY_DEBUG=false
# NLM_PROXY_AUTH_DIR=~/.nlm-proxy

# =============================================================================
# MCP Server (nlm-proxy serve mcp)
# =============================================================================
# NLM_PROXY_MCP_PORT=8000
# NLM_PROXY_MCP_TRANSPORT=stdio

# =============================================================================
# OpenAI Proxy Server (nlm-proxy serve openai)
# =============================================================================
# REQUIRED: API key for authentication (no default - must be set)
# NLM_PROXY_OPENAI_API_KEY=your-secret-key-here
# NLM_PROXY_OPENAI_HOST=0.0.0.0
# NLM_PROXY_OPENAI_PORT=8080
# NLM_PROXY_OPENAI_SESSION_TTL=86400

# =============================================================================
# Authentication (nlm-proxy auth extract / refresh)
# =============================================================================
# NLM_PROXY_AUTH_CHROME_PORT=9222
# NLM_PROXY_AUTH_AUTO_LAUNCH=true

# Auto-refresh settings (background token refresh while proxy is running)
# NLM_PROXY_AUTH_AUTO_REFRESH_ENABLED=true       # Disable to turn off background refresh
# NLM_PROXY_AUTH_CSRF_REFRESH_INTERVAL=1800      # CSRF/session refresh interval in seconds (default: 30 min)
# NLM_PROXY_AUTH_COOKIE_REFRESH_INTERVAL=21600   # Cookie refresh interval in seconds (default: 6 h)
# NLM_PROXY_AUTH_HEADLESS_PORT=9223              # Chrome DevTools port for headless cookie refresh

# =============================================================================
# Logging
# =============================================================================
# NLM_PROXY_LOG_LEVEL=INFO
# NLM_PROXY_LOG_FILE=~/.nlm-proxy/logs/nlm-proxy.log
# NLM_PROXY_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# NLM_PROXY_LOG_MAX_SIZE=10485760
# NLM_PROXY_LOG_BACKUP_COUNT=5

# =============================================================================
# Network Proxy Configuration (Optional)
# =============================================================================
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,::1,nlm-clickhouse,nlm-otel-collector

# =============================================================================
# Smart Routing Configuration
# =============================================================================
# NLM_PROXY_ROUTING_LLM_BASE_URL=https://api.openai.com/v1
# NLM_PROXY_ROUTING_LLM_API_KEY=sk-your-openai-key
# NLM_PROXY_ROUTING_LLM_MODEL=gpt-4o-mini
# NLM_PROXY_ROUTING_ROUTER_MODEL_NAME=knowledge-finder
# NLM_PROXY_ROUTING_ALLOWED_NOTEBOOKS=  # comma-separated notebook IDs, empty=all
# NLM_PROXY_ROUTING_SUMMARY_CACHE_TTL=3600
# NLM_PROXY_ROUTING_SOURCE_FETCH_CONCURRENCY=10  # max parallel source fetches
# NLM_PROXY_ROUTING_MAX_SOURCE_TITLES=15  # max source titles in selection prompt

# Source descriptions (enhanced notebook disambiguation)
# NLM_PROXY_ROUTING_SOURCE_DESCRIPTIONS_ENABLED=true  # include keywords/summaries
# NLM_PROXY_ROUTING_SOURCE_MAX_KEYWORDS=5  # max keywords per source
# NLM_PROXY_ROUTING_SOURCE_SUMMARY_MAX_CHARS=80  # max summary length
# NLM_PROXY_ROUTING_SOURCE_DESCRIPTIONS_MAX_SOURCES=10  # sources with full descriptions

# =============================================================================
# OpenTelemetry Tracing
# =============================================================================
# NLM_PROXY_OTEL_ENABLED=false
# NLM_PROXY_OTEL_ENDPOINT=localhost:4317
# NLM_PROXY_OTEL_SERVICE_NAME=nlm-proxy

# Protocol: grpc or http
# - grpc: Default, lower overhead, no skip-verify support
# - http: Supports skip-verify for self-signed certs
# NLM_PROXY_OTEL_PROTOCOL=grpc

# TLS Configuration
# NLM_PROXY_OTEL_INSECURE=true          # true=plain text, false=TLS enabled
# NLM_PROXY_OTEL_VERIFY_CERT=true       # false to skip cert validation (HTTP only)
# NLM_PROXY_OTEL_CA_CERT_PATH=          # Path to private CA certificate

# Authentication
# NLM_PROXY_OTEL_API_KEY=               # Bearer token for collector auth

# Performance
# NLM_PROXY_OTEL_EXPORT_TIMEOUT=2  # export timeout in seconds (fast fail on unreachable endpoint)
# NLM_PROXY_OTEL_MAX_QUEUE_SIZE=2048  # span queue size (drops oldest when full)
# NLM_PROXY_OTEL_REQUEST_MAX_LENGTH=500  # max chars of user query (0=disable)
# NLM_PROXY_OTEL_RESPONSE_MAX_LENGTH=1000  # max chars of response (0=disable)

# =============================================================================
# Agent Settings (LangChain/LangGraph)
# =============================================================================
# NLM_PROXY_AGENT_LLM_PROVIDER=openai              # openai | anthropic | ollama
# NLM_PROXY_AGENT_EMBEDDING_PROVIDER=huggingface    # huggingface | openai
# NLM_PROXY_AGENT_MEMORY_BACKEND=memory             # memory | sqlite | postgres
# NLM_PROXY_AGENT_MEMORY_DB_PATH=~/.nlm-proxy/memory.db
# NLM_PROXY_AGENT_MAX_ITERATIONS=10
# NLM_PROXY_AGENT_FALLBACK_ON_ERROR=true

# =============================================================================
# Response Cache
# =============================================================================
# NLM_PROXY_CACHE_RESPONSE_CACHE_ENABLED=true     # Enable response caching
# NLM_PROXY_CACHE_RESPONSE_CACHE_TTL=14400         # Cache TTL in seconds (default: 4h)
# NLM_PROXY_CACHE_RESPONSE_CACHE_MAX_ENTRIES=1000  # Max cached responses (LRU eviction)
# NLM_PROXY_CACHE_SEMANTIC_MATCH_ENABLED=true      # Enable semantic matching (smart routing only)
# NLM_PROXY_CACHE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  # HuggingFace model (0.22GB)
# NLM_PROXY_CACHE_SIMILARITY_THRESHOLD=0.5         # Min cosine similarity for L2 pre-filter
# NLM_PROXY_CACHE_SIMILARITY_EXACT_THRESHOLD=0.95  # Skip LLM verification threshold
# NLM_PROXY_CACHE_SEMANTIC_MATCH_TOP_K=10          # Max candidates sent to LLM
