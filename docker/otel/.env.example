# OpenTelemetry Collector Environment Variables
#
# Copy this file to .env and customize values
# Docker Compose will automatically load .env from the same directory

# Bearer token for authentication
# Generate a secure token with: openssl rand -base64 32
# This token must match on both client and collector
OTEL_BEARER_TOKEN=your-secret-token-change-me

# Optional: Server hostname for certificate generation
# Use actual domain in production (e.g., otel.example.com)
OTEL_SERVER_NAME=localhost
